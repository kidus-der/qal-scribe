/* One accent, rounded hairline borders, the state pill sets the colour of the stage border. */

Screen {
    background: $background;
    layout: vertical;
}

/* header */
#top {
    height: 1;
    padding: 0 1;
}
#brand {
    width: auto;
}
#status {
    width: auto;
    padding: 0 0 0 2;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#mic {
    width: 1fr;
    padding: 0 2 0 0;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#pill {
    width: auto;
    padding: 0 1;
    text-style: bold;
    color: auto;  /* built-in themes (`t`): black or white, whichever reads on that state's colour */
    background: $primary;
}
App.-theme-qal #pill, App.-theme-qal-light #pill { color: $background; }

/* stage */
#stage {
    height: 35%;
    min-height: 9;
    max-height: 14;
    margin: 1 1 0 1;
    padding: 0 2;
    background: $surface;
    border: round $primary 60%;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}
#reading {
    height: 1fr;
    scrollbar-size-vertical: 1;
    align: center middle;
}
#hero-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
}
#hero {
    width: 100%;
    text-align: center;
    color: $text-muted;
}
#notes {
    width: 100%;
    text-align: left;
    padding-bottom: 1;
}
#transcript {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $text;
}

/* the live draft and "(nothing recognised)" are muted; Ethiopic fonts have no italic, terminals fake a slant */
#stage.-live #transcript, #stage.-empty #transcript {
    text-style: none;
    color: $text-muted;
}

/* history */
#history-panel {
    height: 1fr;
    margin: 0 1;
    padding: 0 1;
    background: $surface;
    border: round $border;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}
#history {
    height: 1fr;
    background: transparent;
}
#history-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-disabled;
}
HistoryRow {
    height: auto;
    padding: 0 1;
    background: transparent;
    layout: horizontal;
    & > Static { height: auto; }
    & .time { width: 9; color: $text-muted; }
    & .mode { width: 9; color: $text-muted; }
    & .text { width: 1fr; max-height: 2; color: $text; }  /* Enter copies the whole text */
    & .empty { color: $text-disabled; text-style: italic; }
    & .stats { width: auto; padding: 0 2; color: $text-muted; }
    & .paste { width: 1; }
    & .ok { color: $success; }  /* not $accent: many built-in themes use the same colour for accent and warning */
    & .no { color: $warning; }
    & .none { color: $text-muted; }  /* nothing was said: not a failure */
    &.-highlight { background: $primary 20%; }
}
#history:focus > HistoryRow.-highlight { background: $primary 35%; }

/* footer */
#bottom {
    height: 1;
}
Footer {
    dock: none;
    width: 1fr;
    background: transparent;
    & .footer-key--key { color: $accent; background: transparent; text-style: bold; }
    & .footer-key--description { color: $text-muted; background: transparent; }
}
#keys {
    width: auto;
    padding: 0 2;
    color: $text-muted;
}

/* state colours */
Screen.-loading #pill { background: $warning; }
Screen.-loading #stage { border: round $warning 50%; }
Screen.-ready #pill { background: $primary; }
Screen.-recording #pill { background: $error; }
Screen.-recording #stage { border: round $error; }
Screen.-transcribing #pill { background: $warning; }
Screen.-transcribing #stage { border: round $warning; }
Screen.-translating #pill { background: $secondary; }
Screen.-translating #stage { border: round $secondary; }
Screen.-failed #pill { background: $error; }
Screen.-failed #stage { border: round $error; }
Screen.-quitting #pill { background: $warning; }
/* nothing to meter yet: give the rows to the loading message, the start error or the setup warnings */
Screen.-loading Meter, Screen.-failed Meter, Screen.-loading #hero-title, Screen.-failed #hero-title,
Screen.-notes.-ready Meter { display: none; }
Screen.-notes #stage { min-height: 12; }

/* narrow terminals: hotkey reminder moves out of the footer; history text gets the stats' width (the stage
   subtitle shows the latest stats) */
Screen.-narrow #keys, Screen.-narrow HistoryRow .stats { display: none; }
Screen.-narrow #mic { display: none; }  /* a cut-off "mic T…" helps nobody */
Screen.-narrow #status { width: 1fr; padding: 0 2; }

/* under 18 rows: a shorter stage, so the history keeps rows; before the compact block, which wins at 3-5 rows */
Screen.-short #stage { min-height: 6; max-height: 8; }
Screen.-short Meter { height: 1; }  /* the rows go to the transcript and the live draft */
Screen.-short #hero-title { display: none; }
Screen.-short.-notes #stage { min-height: 7; }

/* compact: a 3-5 line strip (header, meter, up to two text lines, footer) for a small always-visible window */
Screen.-compact {
    & #top { padding: 0 1; }
    & #history-panel, & #keys, & #hero-title { display: none; }
    & #stage {
        height: 1fr;
        min-height: 0;
        max-height: 3;
        margin: 0;
        padding: 0 1;
        border: none;
        background: transparent;
    }
    & Meter { height: 1; }
    & #reading { overflow-y: hidden; align: left top; }
    & Toast { padding: 0 1; }  /* a 2-row toast leaves the state pill visible */
    & #hero, & #transcript { text-align: left; padding: 0; }
    &.-tiny #bottom { display: none; }
}
